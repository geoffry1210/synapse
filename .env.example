# Copy this file to .env and fill in real values before running.
# Never commit the real .env file.

DATABASE_URL=postgres://user:password@host/dbname
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Defaults to true (paper trading, no real orders placed). Set to false to go live.
DRY_RUN=true

# Only needed when DRY_RUN=false
BYBIT_API_KEY=
BYBIT_SECRET=
MEXC_API_KEY=
MEXC_SECRET=
BITGET_API_KEY=
BITGET_SECRET=
BITGET_PASSPHRASE=
WEEX_API_KEY=
WEEX_SECRET=
MT5_TOKEN=
MT5_ACCOUNT_ID=

RISK_PCT=1
SIGNAL_TIMEFRAME=1h
POLL_INTERVAL_MS=60000
SCAN_INTERVAL_MS=300000
HOLD_CHECK_INTERVAL_MS=3600000
